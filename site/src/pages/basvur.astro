---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ApplyTimeline from '../components/ApplyTimeline.astro';
import SubpageCTA from '../components/SubpageCTA.astro';
import Reveal from '../components/Reveal.astro';
---

<Base
  title="Başvur — FintechFellow"
  description="2026 Fintech Fellow başvuru süreci ve program takvimi. 42 Türkiye havuz eğitiminden Ödeal'da kariyere adım adım yolculuk."
>
  <Nav darkHero />

  <PageHero eyebrow="2026 Fintech Fellow Başvuru Süreci">
    <Fragment slot="title">
      Başvur. <span class="g">Öğren.</span><br />Dönüş.
    </Fragment>
    <Fragment slot="sub">
      42 Türkiye havuz eğitimiyle başlayan yolculuğunu, Ödeal'da tam zamanlı kariyere dönüştür.
    </Fragment>
  </PageHero>

  <ApplyTimeline />

  <SubpageCTA
    title='Diploma Değil<br><span class="g">Merak Aranıyor</span>'
    sub='9 ay · 15 kişiye kadar alınacaktır · <span class="g">Burs ve iş garantisi</span>'
  />

  <Reveal />
  <Footer />
</Base>
