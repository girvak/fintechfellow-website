  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gray-400);
  padding-top: 2px;
  white-space: nowrap;
}
.journey-cap--end { color: var(--brand-green); text-align: right; }
.journey-axis-track {
  position: relative;
  min-width: 0;
  padding-top: 0;
}
.journey-axis-line {
  position: absolute;
  top: 7px;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(
    90deg,
    var(--brand-blue) 0%,
    var(--brand-green) 50%,
    var(--brand-blue) 100%
  );
  opacity: 0.55;
  z-index: 0;
}
.journey-stops {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
}
.journey-stop {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.journey-chevron {
  flex-shrink: 0;
  font-size: 22px;
  line-height: 1;
  font-weight: 300;
  color: var(--brand-blue-light);
  opacity: 0.65;
  padding-top: 0;
  margin-top: -2px;
}
.journey-stop-period {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-muted);
  text-align: center;
}
.jstep-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 3px var(--bg);
  position: relative;
  z-index: 2;
}
.jstep-dot--blue { background: var(--brand-blue); box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--brand-blue); }
.jstep-dot--green { background: var(--brand-green); box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--brand-green); }
.journey-track {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}
.journey-step {
  position: relative;
  min-width: 0;
}
.jstep-card {
  position: relative;
  height: 100%;
  padding: 28px 24px 32px;
  border-radius: var(--r-lg);
  background: var(--bg-soft);
  border: 1px solid var(--line);
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.jstep-card:hover {
  transform: translateY(-4px);
  border-color: var(--blue-200);
  box-shadow: 0 22px 48px -20px rgba(28, 113, 183, 0.18);
}
.jstep-card--blue:hover {
  box-shadow: 0 22px 48px -20px rgba(28, 113, 183, 0.22);
}
.jstep-card--green:hover {
  border-color: var(--green-200);
  box-shadow: 0 22px 48px -20px rgba(66, 186, 109, 0.2);
}
.jstep-meta {
  display: flex;
  align-items: baseline;
  margin-bottom: 14px;
}
.jstep-num {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--gray-400);
}
.jstep-card--blue .jstep-num { color: color-mix(in srgb, var(--brand-blue) 70%, var(--gray-400)); }
.jstep-card--green .jstep-num { color: color-mix(in srgb, var(--brand-green) 75%, var(--gray-400)); }
.jstep-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: var(--r-pill);
  margin-bottom: 12px;
  color: var(--ink-soft);
  background: color-mix(in srgb, var(--brand-ink) 6%, white);
}
.jstep-card--blue .jstep-tag {
  color: var(--blue-700);
  background: var(--blue-50);
}
.jstep-card--green .jstep-tag {
  color: var(--green-700);
  background: var(--green-50);
}
.jstep-card h3 {
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.02em;
  margin: 0 0 10px;
  line-height: 1.3;
}
.jstep-card p {
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.6;
  margin: 0 0 16px;
}
.jstep-card ul {
  padding: 0;
  margin: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.jstep-card ul li {
  font-size: 13px;
  padding-left: 18px;
  position: relative;
  line-height: 1.45;
  color: color-mix(in srgb, var(--brand-ink) 52%, var(--brand-muted));
}
.jstep-card ul li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.62em;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--brand-green);
  transform: translateY(-50%);
}
@media (max-width: 960px) {
  .journey-axis {
    display: none;
  }
  .journey-track {
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 480px;
    margin: 0 auto;
    padding-left: 28px;
    border-left: 2px solid var(--line);
    position: relative;
  }
  .journey-track::before {
    content: "";
    position: absolute;
    left: -2px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--brand-blue) 0%,
      var(--brand-green) 45%,
      var(--brand-blue) 100%
    );
    opacity: 0.55;
  }
  .journey-step {
    padding: 0 0 28px 20px;
    position: relative;
  }
  .journey-step:last-child { padding-bottom: 0; }
  .journey-step::before {
    content: "";
    position: absolute;
    left: -35px;
    top: 20px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--step-dot, var(--brand-blue));
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--step-dot, var(--brand-blue));
    z-index: 1;
  }
  .journey-step:nth-child(1) { --step-dot: var(--brand-blue); }
  .journey-step:nth-child(2) { --step-dot: var(--brand-green); }
  .journey-step:nth-child(3) { --step-dot: var(--brand-blue); }
  .journey-step::after {
    content: "↓";
    position: absolute;
    left: -30px;
    bottom: 4px;
    font-size: 14px;
    color: var(--brand-blue-light);
    opacity: 0.5;
    line-height: 1;
  }
  .journey-step:last-child::after { display: none; }
}

/* ══════════ 06 PROGRAM İÇERİĞİ ══════════ */
.activities {
  padding: var(--space-2xl) 0;
  background: var(--bg);
  border-top: 1px solid var(--line);
}
/* ══════════ 07 EĞİTİM MODELİ ══════════ */
.ecole {
  padding: var(--space-2xl) 0;
  background: var(--bg);
  border-top: 1px solid var(--line);
}
.ecole-grid {
  display: grid;
  grid-template-columns: minmax(280px, 1.05fr) minmax(300px, 1fr);
  gap: clamp(40px, 5vw, 72px);
  align-items: center;
}
.ecole-copy { max-width: 560px; }
.ecole-prose p {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-soft);
  margin: 0 0 18px;
}
.ecole-prose p:last-child { margin-bottom: 0; }
.ecole-compare-box {
  margin: 28px 0 32px;
  padding: clamp(16px, 2.5vw, 22px);
  border-radius: var(--r-lg);
  border: 1px solid var(--line);
  background: var(--bg-soft);
  box-shadow: 0 12px 32px -24px rgba(28, 113, 183, 0.12);
}
.ecole-compare {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
.ecole-swap {
  display: grid;
  grid-template-columns: minmax(84px, 1fr) 28px minmax(84px, 1.1fr);
  align-items: center;
  column-gap: 6px;
  padding: 16px 14px;
  border-radius: var(--r-md);
  border: 1px solid var(--line);
  background: var(--bg);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.ecole-swap:hover {
  border-color: var(--blue-200);
  box-shadow: 0 8px 24px -16px rgba(28, 113, 183, 0.18);
}
.ecole-swap-old {
  justify-self: end;
  text-align: right;
  font-size: 14px;
  font-weight: 600;
  color: #b8bec8;
  text-decoration: line-through;
  line-height: 1.2;
}
.ecole-swap-mid {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: var(--blue-50);
  color: var(--brand-blue);
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
}
.ecole-swap-new {
  justify-self: start;
  text-align: left;
  font-size: 14px;
  font-weight: 700;
  color: var(--brand-green);
  line-height: 1.2;
}

.ecole-visual {
  aspect-ratio: 1;
  border-radius: var(--r-lg);
  background: var(--ink);
  color: #fff;
  padding: clamp(36px, 5vw, 52px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 20px;
  position: relative;
  overflow: hidden;
  min-height: 360px;
}
.ecole-visual::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.4;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
}
.ecole-visual::after {
  content: "";
  position: absolute;
  width: 320px;
  height: 320px;
  top: -100px;
  right: -80px;
  background: radial-gradient(circle, rgba(66, 186, 109, 0.35) 0%, transparent 68%);
  pointer-events: none;
}
.ecole-num {
  font-weight: 900;
  font-size: clamp(120px, 14vw, 200px);
  line-height: 0.9;
  letter-spacing: -0.06em;
  color: #fff;
  position: relative;
  z-index: 1;
  margin-top: auto;
}
.ecole-num-accent { color: var(--brand-green); }
.ecole-caption {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.72);
  position: relative;
  z-index: 1;
  max-width: 48ch;
  line-height: 1.55;
  margin: 0;
  font-weight: 400;
}
.ecole-footnote {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.38);
  position: relative;
  z-index: 1;
  margin: 0;
  letter-spacing: 0.02em;
}

@media (max-width: 960px) {
  .ecole-grid { grid-template-columns: 1fr; }
  .ecole-copy { max-width: none; }
}
@media (max-width: 640px) {
  .ecole-compare-box { padding: 14px; }
  .ecole-compare { grid-template-columns: 1fr; }
  .ecole-swap {
    grid-template-columns: minmax(72px, 1fr) 28px minmax(72px, 1.1fr);
  }
}
@media (max-width: 560px) {
  .ecole-visual {
    min-height: 300px;
    aspect-ratio: auto;
  }
  .ecole-num { font-size: 100px; }
}

/* ══════════ 08 MEZUNLAR — kişi kartları ══════════ */
.testimonials {
  padding: var(--space-2xl) 0;
  background: var(--blue-light-50);
  border-top: 1px solid var(--blue-light-100);
  position: relative;
  overflow: hidden;
}
.testimonials::before {
  content: "";
  position: absolute;
  top: -120px;
  right: -80px;
  width: 360px;
  height: 360px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--brand-green) 12%, transparent), transparent 68%);
  pointer-events: none;
}
.testimonials::after {
  content: "";
  position: absolute;
  bottom: -100px;
  left: -60px;
  width: 280px;
  height: 280px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--brand-blue-light) 18%, transparent), transparent 70%);
  pointer-events: none;
}
.testimonials .container {
  position: relative;
  z-index: 1;
}
.test-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 24px;
  flex-wrap: wrap;
  margin-bottom: 48px;
}

.alumni-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  align-items: stretch;
}
.alumni-card {
  padding: 28px 24px 24px;
  border-radius: var(--r-xl);
  border: 1px solid var(--blue-light-100);
  background: var(--bg);
  display: grid;
  grid-template-rows: 86px 58px minmax(188px, 1fr);
  row-gap: 18px;
  min-height: 100%;
  box-shadow: 0 8px 28px -16px rgba(28, 113, 183, 0.08);
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.alumni-card:hover {
  transform: translateY(-5px);
  border-color: var(--blue-200);
  box-shadow: 0 24px 48px -20px rgba(28, 113, 183, 0.18);
}

.alumni-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 0;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
  min-height: 0;
  box-sizing: border-box;
}
.alumni-card-lead {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1;
}
.alumni-avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  color: #fff;
  font-weight: 700;
  font-size: 17px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alumni-avatar--photo {
  display: block;
  object-fit: cover;
  border: 2px solid var(--line);
  box-shadow: 0 2px 8px rgba(14, 17, 22, 0.08);
}
.av-lm { background: linear-gradient(135deg, var(--brand-blue), var(--brand-green)); }
.av-gd { background: linear-gradient(135deg, var(--brand-green), var(--brand-blue-light)); }
.av-bd { background: linear-gradient(135deg, var(--blue-900), var(--brand-blue)); }

.alumni-identity {
  min-width: 0;
  flex: 1;
}
.alumni-name {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: 0;
  line-height: 1.2;
}
.alumni-first {
  font-weight: 700;
  font-size: 19px;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.alumni-last {
  font-weight: 600;
  font-size: 16px;
  letter-spacing: -0.01em;
  color: var(--ink-soft);
}

.alumni-meta {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 5px;
  flex-shrink: 0;
  width: 92px;
}
.alumni-cohort,
.alumni-linkedin {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-height: 26px;
  padding: 5px 10px;
  border-radius: var(--r-pill);
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  box-sizing: border-box;
}
.alumni-cohort {
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-muted);
  background: var(--bg-soft);
  border: 1px solid var(--line);
}
.alumni-linkedin {
  --linkedin-brand: #0a66c2;
  color: var(--linkedin-brand);
  text-decoration: none;
  letter-spacing: 0.02em;
  text-transform: none;
  font-weight: 600;
  background: color-mix(in srgb, var(--linkedin-brand) 8%, var(--bg));
  border: 1px solid color-mix(in srgb, var(--linkedin-brand) 22%, var(--line));
  transition: background 0.2s, border-color 0.2s;
}
.alumni-linkedin:hover {
  background: color-mix(in srgb, var(--linkedin-brand) 14%, var(--bg));
  border-color: color-mix(in srgb, var(--linkedin-brand) 38%, var(--line));
}
.alumni-linkedin-icon {
  flex-shrink: 0;
  display: block;
}

.alumni-path {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 10px 10px 8px;
  border-radius: var(--r-md);
  background: var(--bg-soft);
  border: 1px solid var(--line);
  box-sizing: border-box;
  min-height: 0;
}
.alumni-path-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.alumni-path-side--after {
  align-items: flex-end;
  text-align: right;
}
.alumni-path-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-muted);
  line-height: 1;
}
.alumni-path-side--after .alumni-path-label {
  color: var(--green-700);
}
.alumni-path-val {
  font-size: 11px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.3;
  max-width: 100%;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.alumni-path-side--after .alumni-path-val {
  color: var(--brand-green);
  font-weight: 700;
  text-align: right;
}
.alumni-path-arrow {
  flex-shrink: 0;
  align-self: center;
  color: var(--brand-blue);
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
}

.alumni-quote {
  margin: 0;
  padding: 18px 16px 16px 20px;
  border-top: 1px solid var(--line);
  border-radius: 0 0 var(--r-md) var(--r-md);
  background: var(--bg-soft);
  position: relative;
  min-height: 188px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.alumni-quote-mark {
  position: absolute;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 900;
  line-height: 1;
  pointer-events: none;
  z-index: 0;
  user-select: none;
}
.alumni-quote-mark--open {
  top: 12px;
  left: 12px;
  font-size: 72px;
  color: var(--brand-blue);
  opacity: 0.92;
  letter-spacing: -0.05em;
}
.alumni-quote-mark--close {
  right: 12px;
  bottom: 10px;
  font-size: 64px;
  color: var(--brand-green);
  opacity: 0.92;
  letter-spacing: -0.05em;
}
.alumni-quote p {
  position: relative;
  z-index: 1;
  font-size: 14px;
  line-height: 1.72;
  color: var(--ink-soft);
  margin: 0;
  padding: 52px 8px 40px 4px;
  font-weight: 400;
  flex: 1;
}

@media (max-width: 1024px) {
  .alumni-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 640px) {
  .alumni-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .alumni-card {
    padding: 28px 22px 24px;
  }
  .alumni-card-head {
    flex-direction: column;
    gap: 14px;
  }
  .alumni-meta {
    width: 100%;
    flex-direction: row;
    gap: 8px;
  }
  .alumni-cohort,
  .alumni-linkedin {
    flex: 1;
  }
  .test-head { align-items: flex-start; }
}

/* ══════════ 04b BAŞVURU KOŞULLARI ══════════ */
.callout-band {
  padding: clamp(88px, 10vw, 120px) 0;
  background: var(--ink);
  color: #fff;
  position: relative;
  overflow: hidden;
}
.callout-band::before {
  content: "";
  position: absolute; top: -80px; right: -80px;
  width: 360px; height: 360px; border-radius: 50%;
  background: radial-gradient(circle, rgba(66,186,109,0.14), transparent 65%);
  pointer-events: none;
}
.cb-inner {
  display: grid;
  grid-template-columns: minmax(200px, 36%) 1fr;
  gap: clamp(40px, 5vw, 72px);
  align-items: center;
}
.cb-left {
  padding-right: clamp(8px, 1.5vw, 20px);
}
.cb-right {
  margin-left: clamp(56px, 11vw, 160px);
  max-width: 580px;
}
.cb-kicker {
  margin: 0 0 14px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.4;
}
.cb-title {
  font-weight: 900;
  font-size: clamp(48px, 6vw, 88px);
  line-height: 1;
  letter-spacing: -0.04em;
  margin: 0 0 14px;
  color: var(--brand-green);
}
.cb-title--left {
  font-size: clamp(24px, 2.85vw, 36px);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.03em;
  margin: 0;
  max-width: 22em;
  text-wrap: balance;
}
.cb-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: clamp(26px, 3.4vh, 38px);
}
.cb-item {
  display: flex;
  align-items: flex-start;
  gap: 18px;
}
.cb-mark {
  flex-shrink: 0;
  width: 24px;
  font-size: 20px;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
}
.cb-mark--no { color: rgba(255,255,255,0.22); }
.cb-mark--yes { color: var(--brand-green); }
.cb-body strong {
  display: block;
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 4px;
