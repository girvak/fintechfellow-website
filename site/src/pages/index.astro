---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroIntro from '../components/HeroIntro.astro';
import SubpageCTA from '../components/SubpageCTA.astro';
import ProgramContent from '../components/ProgramContent.astro';
import { alumniForHomepage } from '../data/alumni';
import { homepageFaqGroups } from '../data/faq';
import { partnerLogos } from '../data/partners';

/** Geçici: «9 ayın haritası» (journey) bölümü */
const SHOW_JOURNEY_MAP = false;
---

<Base>
  <Nav darkHero />
  <HeroIntro />

  <!-- ══════════════════════════════════════════
       01  HERO
  ══════════════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="hero-floats" aria-hidden="true">
      <div class="chev">&lt;/&gt;</div>
      <div class="chev">//</div>
      <div class="chev">{ }</div>
      <div class="chev">&amp;&amp;</div>
      <div class="chev">[ ]</div>
      <div class="chev">&lt;&gt;</div>
    </div>

    <div class="container hero-stage">
      <div class="hero-head">
        <div class="hero-title-main">
          <span class="hero-line">Fintech</span>
          <span class="hero-line">Fellow</span>
        </div>
        <p class="hero-tagline hero-line hero-title-muted">Ödeal'da iş ve burs garantisi</p>
      </div>

      <p class="hero-sub">
        <strong>Üniversite, tecrübe veya bölüm şartı yok.</strong><br>
        18–27 yaş arası 15 Genç.
      </p>
    </div>

    <aside class="hero-partners" aria-label="Program ortakları">
      <div class="hero-partners-box">
        <p class="hero-partners-label">
          <span>Partnerler</span>
        </p>
        <div class="hero-partners-divider" aria-hidden="true"></div>
        <ul class="hero-partner-logos">
          <li>
            <img class="hpl-logo hpl-logo--odeal" src={partnerLogos.odeal} alt="Ödeal" loading="lazy" decoding="async" />
          </li>
          <li>
            <img class="hpl-logo hpl-logo--42" src={partnerLogos.fortyTwoTurkiye} alt="42 Türkiye" loading="lazy" decoding="async" />
          </li>
          <li>
            <img class="hpl-logo hpl-logo--girvak" src={partnerLogos.girvak} alt="Girişimcilik Vakfı" loading="lazy" decoding="async" />
          </li>
        </ul>
      </div>
    </aside>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll-text">aşağı kaydır</span>
      <div class="hero-scroll-indicator">
        <div class="hero-scroll-mouse"></div>
      </div>
    </div>

    <button type="button" class="hero-replay-intro" id="hero-replay-intro" aria-label="Açılış animasyonunu tekrar izle">
      <span class="hero-replay-intro__icon" aria-hidden="true">▶</span>
      Intro'yu tekrar izle
    </button>
  </section>

  <!-- ══════════════════════════════════════════
       02  BAŞVURU KOŞULLARI
  ══════════════════════════════════════════ -->
  <section class="callout-band">
    <div class="container cb-inner">
      <div class="cb-left reveal">
        <p class="cb-kicker">Başvuru için tek koşul:</p>
        <h2 class="cb-title cb-title--left">
          18–27 yaş aralığında olmak ve yazılıma gerçek merak.
        </h2>
      </div>
      <div class="cb-right reveal" data-delay="1">
        <ul class="cb-list">
          <li class="cb-item">
            <span class="cb-mark cb-mark--no" aria-hidden="true">×</span>
            <div class="cb-body">
              <strong>Üniversite, tecrübe veya bölüm şartı yok.</strong>
              <span>Sadece eğitimlere tam katılım, yazılım sektörüne merak ve ilgi yeterli.</span>
            </div>
          </li>
          <li class="cb-item">
            <span class="cb-mark cb-mark--no" aria-hidden="true">×</span>
            <div class="cb-body">
              <strong>Üniversiteye gitmen gerekmiyor.</strong>
              <span>Açık öğretim, üniversiteyi bırakmış veya hiç başlamamış herkes başvurabilir.</span>
            </div>
          </li>
          <li class="cb-item">
            <span class="cb-mark cb-mark--no" aria-hidden="true">×</span>
            <div class="cb-body">
              <strong>Yazılım bilmen gerekmiyor.</strong>
              <span>Sıfırdan başlayan herkes programı tamamlayarak kariyer yolculuğuna başladı.</span>
            </div>
          </li>
          <li class="cb-item">
            <span class="cb-mark cb-mark--no" aria-hidden="true">×</span>
            <div class="cb-body">
              <strong>Üniversitedeysen eğer, bölümün fark etmiyor.</strong>
              <span>İnşaat, iktisat, sağlık.. Tüm Fellow'larımız farklı yeteneklere sahip.</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       03  PROGRAM NEDİR
  ══════════════════════════════════════════ -->
  <section class="about" id="program">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <div class="sec-eyebrow">Program nedir?</div>
        <h2 class="sec-title">9 ay sonra <span class="g">tam zamanlı kariyerin</span> başlıyor.</h2>
        <p class="sec-sub">
          FinTech Fellow 2.0, <strong>Ödeal</strong>, <strong>42 Türkiye</strong> ve <strong>GİRVAK</strong>
          iş birliğiyle hayata geçirilen <strong>istihdam garantili</strong> bir burs programı.
          Yazılımı öğreniyorsun, fintech'i keşfediyorsun, kariyerine Ödeal'da başlıyorsun.
        </p>
        <div class="about-actions">
          <a href="/basvur" class="btn-primary">Başvur <span class="arrow">→</span></a>
          <a href="/program" class="btn-outline">Programı Keşfet <span class="arrow">→</span></a>
      </div>
    </div>

      <div class="counters reveal" data-delay="1">
        <div class="counter-card counter-card--blue">
          <div class="cnum"><span class="counter" data-target="9">0</span><span class="cunit">Ay</span></div>
          <div class="clabel">Program Süresi<span class="csmall">Eğitim → Bootcamp → Mentörlük</span></div>
        </div>
        <div class="counter-card counter-card--green">
          <div class="cnum"><span class="counter" data-target="20">0</span><span class="cnum-bin">B</span><span class="cunit">TL</span></div>
          <div class="clabel">Aylık Burs<span class="csmall">Tüm Program Boyunca</span></div>
        </div>
        <div class="counter-card counter-card--dark">
          <div class="cnum"><span class="counter" data-target="15">0</span><span class="cunit">Fellow</span></div>
          <div class="clabel">Kontenjan<span class="csmall">15 Kişiye Kadar, 15 Kariyer</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       04  NE KAZANIYORSUN
  ══════════════════════════════════════════ -->
  <section class="perks">
    <div class="container">
      <div class="perks-head reveal">
        <div class="sec-eyebrow perks-eyebrow">Ne kazanıyorsun?</div>
        <h2 class="perks-title">4 büyük <span class="g">kazanım</span></h2>
      </div>
      <div class="perks-grid">
        <article class="perk-card perk-card--blue reveal" data-delay="1">
          <span class="perk-num" aria-hidden="true">01</span>
          <h3 class="perk-title">Ödeal'da İş Garantisi</h3>
          <p class="perk-text">Programı başarıyla tamamladığında Ödeal'da tam zamanlı işe başlıyorsun.</p>
        </article>
        <article class="perk-card perk-card--green reveal" data-delay="2">
          <span class="perk-num" aria-hidden="true">02</span>
          <h3 class="perk-title">Aylık 20.000 TL Burs</h3>
          <p class="perk-text">9 ay boyunca kesintisiz burs. Tek odağın eğitimin olsun.</p>
        </article>
        <article class="perk-card perk-card--blue reveal" data-delay="3">
          <span class="perk-num" aria-hidden="true">03</span>
          <h3 class="perk-title">Sektörel Network</h3>
          <p class="perk-text">CEO buluşmaları, mentörlük ve FinTalks etkinlikleriyle sektörel bir topluluğa dahil oluyorsun.</p>
        </article>
        <article class="perk-card perk-card--green reveal" data-delay="4">
          <span class="perk-num" aria-hidden="true">04</span>
          <h3 class="perk-title">42 Türkiye Eğitimi</h3>
          <p class="perk-text">Ücretsiz ve ön koşulsuz eğitim sunan, proje tabanlı bir yazılım okulunda aldığın eğitim sonrasında Fintech Fellow Programına dahil olursun.</p>
        </article>
      </div>
    </div>
  </section>

  {/* ══ 9 AYIN HARİTASI — şimdilik gizli ══ */}
  {SHOW_JOURNEY_MAP && (
  <section class="journey">
    <div class="container">
      <div class="journey-head reveal">
        <div class="sec-eyebrow">9 ayın haritası</div>
        <h2 class="sec-title">Sıfırdan yazılım öğrenerek <span class="g">tam zamanlı geliştirici</span> olabilirsin.</h2>
      </div>

      <div class="journey-roadmap">
        <div class="journey-axis reveal" data-delay="1">
          <span class="journey-cap journey-cap--start">Başlangıç</span>
          <div class="journey-axis-track">
            <div class="journey-axis-line" aria-hidden="true"></div>
            <div class="journey-stops">
              <div class="journey-stop">
                <span class="jstep-dot jstep-dot--blue" aria-hidden="true"></span>
                <span class="journey-stop-period">Ay 1–4</span>
              </div>
              <span class="journey-chevron" aria-hidden="true">›</span>
              <div class="journey-stop">
                <span class="jstep-dot jstep-dot--green" aria-hidden="true"></span>
                <span class="journey-stop-period">Ay 4–7</span>
              </div>
              <span class="journey-chevron" aria-hidden="true">›</span>
              <div class="journey-stop">
                <span class="jstep-dot jstep-dot--blue" aria-hidden="true"></span>
                <span class="journey-stop-period">Ay 7–9</span>
              </div>
            </div>
          </div>
          <span class="journey-cap journey-cap--end">Ödeal'da iş</span>
        </div>

        <div class="journey-track">
        <article class="journey-step reveal" data-delay="1">
          <div class="jstep-card jstep-card--blue">
            <div class="jstep-meta">
              <span class="jstep-num">01</span>
          </div>
            <span class="jstep-tag">Temel</span>
            <h3>42 Türkiye Yazılım Eğitimi</h3>
            <p>Peer-to-peer öğrenme modeliyle yazılımın temelden derinlerine iniyorsun. Sınıf yok, eğitmen yok; sadece sen, akranların ve projeler.</p>
            <ul>
              <li>Sıfırdan ileri seviyeye C, Unix, ağ programlama</li>
              <li>Algoritma ve veri yapıları üzerine gerçek projeler</li>
              <li>Akran değerlendirmesi ile sürekli geri bildirim</li>
              <li>Kendi ritminde eğitim</li>
            </ul>
          </div>
        </article>

        <article class="journey-step reveal" data-delay="2">
          <div class="jstep-card jstep-card--green">
            <div class="jstep-meta">
              <span class="jstep-num">02</span>
          </div>
            <span class="jstep-tag">Uzmanlık</span>
            <h3>Fintech Alanında Kariyer</h3>
            <p>Fintech Fellow Programı'nda amacımız sana fintech'i sınıfta anlatmak değil; sektörün içindeki profesyonellerle bir araya getirerek gerçek iş dünyasını deneyimlemeni sağlamak.</p>
            <ul>
              <li>Fintech liderleriyle ilham ve kariyer buluşmaları</li>
              <li>CTO, CEO ve sektör uzmanlarıyla networking fırsatları</li>
              <li>Agile &amp; Scrum çalışma modellerine yönelik atölyeler</li>
              <li>Uluslararası fintech etkinliklerine katılım</li>
              <li>Gerçek sektör deneyimlerine ve vaka paylaşımlarına erişim</li>
              <li>Fintech ekosisteminde güçlü bir profesyonel ağ oluşturma imkânı.</li>
            </ul>
          </div>
        </article>

        <article class="journey-step reveal" data-delay="3">
          <div class="jstep-card jstep-card--blue">
            <div class="jstep-meta">
              <span class="jstep-num">03</span>
          </div>
            <span class="jstep-tag">Kariyer</span>
            <h3>Mentörlük &amp; İş Garantisi</h3>
            <p>CEO buluşmaları, birebir mentörlük ve FinTalks ile sektöre dahil oluyor, program sonunda Ödeal'da tam zamanlı başlıyorsun.</p>
            <ul>
              <li>Birebir sektör mentörlüğü</li>
              <li>CEO &amp; lider buluşmaları</li>
              <li>Ödeal'da tam zamanlı iş</li>
            </ul>
          </div>
        </article>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- ══════════════════════════════════════════
       06  PROGRAM İÇERİĞİ
  ══════════════════════════════════════════ -->
  <section class="activities" id="aktiviteler">
    <div class="container">
      <ProgramContent
        rootId="homepage-program-content"
        title='9 ay boyunca <span class="g">tam bir profesyonel</span> olarak yetişiyorsun.'
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       07  EĞİTİM MODELİ
  ══════════════════════════════════════════ -->
  <section class="ecole" id="egitim-modeli">
    <div class="container ecole-grid">
      <div class="ecole-copy reveal">
        <div class="sec-eyebrow">Eğitim modeli</div>
        <h2 class="sec-title">42 Türkiye'yi <span class="g">farklı</span> kılan nedir?</h2>
        <div class="ecole-prose">
          <p>42 Türkiye, proje tabanlı ve akran öğrenimine dayalı bir eğitim modelidir. Öğrenciler gerçek projeler üzerinde çalışırken teknik yetkinliklerini geliştirir, problem çözme becerileri kazanır ve birbirlerinden öğrenir. Öğrenme süreci teoriyi uygulamaya dönüştürmeye, üretmeye ve deneyim kazanmaya odaklanır.</p>
          <p>42 Türkiye ile teknik temellerini oluştur, Fintech Fellow Programı ile sektör deneyimi kazan.</p>
        </div>
        <div class="ecole-compare-box">
          <ul class="ecole-compare">
            <li class="ecole-swap">
              <span class="ecole-swap-old">Teori</span>
              <span class="ecole-swap-mid" aria-hidden="true">›</span>
              <span class="ecole-swap-new">Pratik</span>
            </li>
            <li class="ecole-swap">
              <span class="ecole-swap-old">Eğitmen</span>
              <span class="ecole-swap-mid" aria-hidden="true">›</span>
              <span class="ecole-swap-new">Akranlar</span>
            </li>
            <li class="ecole-swap">
              <span class="ecole-swap-old">Sınıf</span>
              <span class="ecole-swap-mid" aria-hidden="true">›</span>
              <span class="ecole-swap-new">Proje</span>
            </li>
            <li class="ecole-swap">
              <span class="ecole-swap-old">Ders</span>
              <span class="ecole-swap-mid" aria-hidden="true">›</span>
              <span class="ecole-swap-new">Keşif</span>
            </li>
          </ul>
        </div>
        <a href="https://42istanbul.com.tr" target="_blank" rel="noopener noreferrer" class="inline-link">
          42 Türkiye'yi keşfet <span>↗</span>
        </a>
      </div>

      <div class="ecole-visual reveal" data-delay="1">
        <div class="ecole-num">
          <span class="ecole-num-accent">+</span>42<span class="ecole-num-accent">°</span>
        </div>
        <p class="ecole-caption">Gerçek projeler, akran öğrenimi ve sürekli geri bildirimle ilerleyen bir öğrenme deneyimi. Kendi hızında öğrenir, üreterek gelişir ve öğrendiklerini uygulamaya dönüştürürsün.</p>
        <p class="ecole-footnote">50+ ülkede aynı model · 42 Türkiye</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       08  TESTİMONİALS
  ══════════════════════════════════════════ -->
  <section class="testimonials" id="mezunlar">
    <div class="container">
      <div class="test-head">
        <div class="reveal">
          <div class="sec-eyebrow">Mezunlarımız</div>
          <h2 class="sec-title">9 Ayda Kariyerini Baştan Yazan <span class="g">Fellow'larımız</span></h2>
        </div>
        <a href="/mezunlar" class="inline-link reveal" data-delay="1">Tüm hikayeleri gör <span>→</span></a>
      </div>

      <div class="alumni-grid">
        {alumniForHomepage.map((person, i) => (
          <article class={`alumni-card reveal`} data-delay={String(i + 1)}>
            <header class="alumni-card-head">
              <div class="alumni-card-lead">
                {person.photo ? (
                  <img
                    class="alumni-avatar alumni-avatar--photo"
                    src={person.photo}
                    alt={person.name}
                    width="56"
                    height="56"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class={`alumni-avatar av-${person.bg}`}>{person.initials}</div>
                )}
                <div class="alumni-identity">
                  <h3 class="alumni-name">
                    <span class="alumni-first">{person.firstName}</span>
                    <span class="alumni-last">{person.lastName}</span>
                  </h3>
            </div>
              </div>
              <div class="alumni-meta">
                <span class="alumni-cohort">{person.cohort}</span>
                {person.linkedin && (
                  <a
                    href={person.linkedin}
                    class="alumni-linkedin"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${person.name} LinkedIn profili`}
                  >
                    <svg class="alumni-linkedin-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    <span>LinkedIn</span>
                  </a>
                )}
              </div>
            </header>

            <div class="alumni-path">
              <div class="alumni-path-side alumni-path-side--before">
                <span class="alumni-path-label">Önce</span>
                <span class="alumni-path-val">{person.before}</span>
              </div>
              <span class="alumni-path-arrow" aria-hidden="true">→</span>
              <div class="alumni-path-side alumni-path-side--after">
                <span class="alumni-path-label">Ödeal'da</span>
                <span class="alumni-path-val">{person.after}</span>
              </div>
            </div>

            <blockquote class="alumni-quote">
              <span class="alumni-quote-mark alumni-quote-mark--open" aria-hidden="true">&#8220;</span>
              <span class="alumni-quote-mark alumni-quote-mark--close" aria-hidden="true">&#8221;</span>
              <p>{person.quote}</p>
          </blockquote>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       09  SSS
  ══════════════════════════════════════════ -->
  <section class="faq-section" id="sss">
    <div class="container faq-inner">
      <div class="faq-head reveal">
        <div class="sec-eyebrow">Bu soruların aklına geldiğinden eminiz!</div>
        <h2 class="sec-title">Aklındaki <span class="g">soruların</span> yanıtı.</h2>
        <p class="faq-sub">Başvuru adımları, 42 Türkiye havuz eğitimi, burs ve iş garantisi hakkında en çok merak edilenler.</p>
      </div>

      <div class="faq-groups">
        {homepageFaqGroups.map((group) => {
          const left = group.items.filter((_, i) => i % 2 === 0);
          const right = group.items.filter((_, i) => i % 2 === 1);
          return (
            <div class="faq-group reveal">
              <h3 class="faq-group-label">{group.label}</h3>
              <div class="faq-grid">
                <div class="faq-col">
                  {left.map((item, i) => (
                    <details class={`faq-item faq-item--${i % 2 === 0 ? 'blue' : 'green'} reveal`} data-delay={String(Math.min(i * 2 + 1, 5))}>
                      <summary>
                        <span class="faq-q">{item.q}</span>
                        <span class="faq-toggle" aria-hidden="true"></span>
                      </summary>
                      <div class="faq-panel">
                        <div class="faq-a-wrap">
                          {item.a.split(/\n\n+/).map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                          {item.cta && (
                            <p class="faq-cta-link">
                              <a
                                href={item.cta.href}
                                {...(item.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                              >
                                {item.cta.label} <span>{item.cta.href.startsWith('http') ? '↗' : '→'}</span>
                              </a>
                            </p>
                          )}
                        </div>
                      </div>
                    </details>
                  ))}
                </div>
                <div class="faq-col">
                  {right.map((item, i) => (
                    <details class={`faq-item faq-item--${i % 2 === 0 ? 'green' : 'blue'} reveal`} data-delay={String(Math.min(i * 2 + 2, 5))}>
                      <summary>
                        <span class="faq-q">{item.q}</span>
                        <span class="faq-toggle" aria-hidden="true"></span>
                      </summary>
                      <div class="faq-panel">
                        <div class="faq-a-wrap">
                          {item.a.split(/\n\n+/).map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                          {item.cta && (
                            <p class="faq-cta-link">
                              <a
                                href={item.cta.href}
                                {...(item.cta.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                              >
                                {item.cta.label} <span>{item.cta.href.startsWith('http') ? '↗' : '→'}</span>
                              </a>
                            </p>
                          )}
                        </div>
                      </div>
                    </details>
                  ))}
                  {group.id === 'program' && (
                    <details class="faq-item faq-item--dark reveal" data-delay="5">
                      <summary>
                        <span class="faq-q">Cevabını bulamadığın <span class="faq-q-accent">bir şey mi var?</span></span>
                        <span class="faq-toggle" aria-hidden="true"></span>
                      </summary>
                      <div class="faq-panel">
                        <div class="faq-a-wrap">
                          <div class="faq-actions">
                            <a href="/iletisim" class="faq-action-btn">Bize yaz <span>→</span></a>
                            <a href="/basvur" class="faq-action-btn faq-action-btn--outline">Başvuru takvimi <span>→</span></a>
                          </div>
                        </div>
                      </div>
                    </details>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <SubpageCTA
    sectionId="basvur"
    title='15 Kişiye Kadar<br><span class="g">15 Kariyer</span>'
    sub="15 kişiye kadar alınacaktır · Ücretsiz başvuru"
  />

  <Footer />
</Base>

