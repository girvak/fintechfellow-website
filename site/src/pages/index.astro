/* ══════════ 09 SSS ══════════ */
.faq-section {
  padding: var(--space-2xl) 0;
  background: var(--bg);
  border-top: 1px solid var(--line);
}
.faq-head {
  margin-bottom: 44px;
  max-width: 560px;
}
.faq-groups {
  display: flex;
  flex-direction: column;
  gap: 48px;
}
.faq-group-label {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 0 0 20px;
}
.faq-cta-link {
  margin: 14px 0 0;
}
.faq-cta-link a {
  font-size: 14px;
  font-weight: 600;
  color: var(--blue-500);
  text-decoration: none;
}
.faq-cta-link a:hover {
  text-decoration: underline;
}
.faq-sub {
  margin: 14px 0 0;
  font-size: 16px;
  line-height: 1.65;
  color: var(--ink-soft);
}

.faq-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 20px;
  margin-bottom: 40px;
  align-items: start;
}
.faq-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.faq-item {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--bg-soft);
  overflow: hidden;
  transition: border-color 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
}
.faq-item.reveal {
  opacity: 0;
  transform: translateY(20px);
  transition:
    opacity 0.6s ease,
    transform 0.6s cubic-bezier(0.33, 1, 0.68, 1),
    border-color 0.35s ease,
    box-shadow 0.35s ease,
    background 0.35s ease;
}
.faq-item.reveal.in {
  opacity: 1;
  transform: translateY(0);
}
.faq-item[open] {
  background: var(--bg);
  border-color: var(--blue-200);
  box-shadow: 0 14px 36px -20px rgba(28, 113, 183, 0.14);
}
.faq-item--green[open] {
  border-color: var(--green-200);
  box-shadow: 0 14px 36px -20px rgba(66, 186, 109, 0.12);
}

.faq-item summary {
  padding: 18px 18px;
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  user-select: none;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-q {
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  transition: color 0.35s ease;
}
.faq-item[open] .faq-q {
  color: var(--brand-blue);
}
.faq-item--green[open] .faq-q {
  color: var(--brand-green);
}

.faq-toggle {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: var(--blue-light-50);
  border: 1px solid var(--blue-light-100);
  position: relative;
  transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease;
}
.faq-toggle::before,
.faq-toggle::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  background: var(--brand-blue);
  border-radius: 1px;
  transform: translate(-50%, -50%);
  transition: transform 0.35s cubic-bezier(0.33, 1, 0.68, 1), opacity 0.3s ease;
}
.faq-toggle::before {
  width: 12px;
  height: 2px;
}
.faq-toggle::after {
  width: 2px;
  height: 12px;
}
.faq-item--green .faq-toggle {
  background: var(--green-50);
  border-color: var(--green-200);
}
.faq-item--green .faq-toggle::before,
.faq-item--green .faq-toggle::after {
  background: var(--brand-green);
}
.faq-item[open] .faq-toggle::after {
  transform: translate(-50%, -50%) scaleY(0);
  opacity: 0;
}
.faq-item[open] .faq-toggle {
  background: color-mix(in srgb, var(--brand-green) 12%, var(--bg));
  border-color: var(--green-200);
}
.faq-item--blue[open] .faq-toggle {
  background: var(--blue-50);
  border-color: var(--blue-200);
}

.faq-panel {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.34s ease-out;
}
.faq-a-wrap {
  /* summary ile aynı yatay (18px); altta ekstra nefes payı */
  padding: 14px 18px 26px;
}
.faq-a-wrap p {
  margin: 0;
  font-size: 14px;
  line-height: 1.72;
  color: var(--ink-soft);
}
.faq-a-wrap .faq-actions {
  margin: 0;
}
@media (prefers-reduced-motion: reduce) {
  .faq-panel,
  .faq-item,
  .faq-q,
  .faq-toggle,
  .faq-toggle::before,
  .faq-toggle::after {
    transition: none !important;
  }
}

.faq-item--dark {
  background: var(--ink);
  border-color: color-mix(in srgb, var(--ink) 88%, white);
}
.faq-item--dark .faq-q {
  color: #fff;
}
.faq-item--dark .faq-q-accent {
  color: var(--brand-green);
}
.faq-item--dark[open] .faq-q-accent {
  color: var(--green-500);
}
.faq-item--dark .faq-toggle {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.14);
}
.faq-item--dark .faq-toggle::before,
.faq-item--dark .faq-toggle::after {
  background: #fff;
}
.faq-item--dark[open] {
  background: var(--ink);
  border-color: rgba(255, 255, 255, 0.22);
  box-shadow: 0 14px 36px -20px rgba(0, 0, 0, 0.35);
}
.faq-item--dark[open] .faq-q {
  color: rgba(255, 255, 255, 0.92);
}
.faq-item--dark[open] .faq-toggle {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.2);
}
.faq-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.faq-action-btn {
  flex: 1 1 140px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px 16px;
  border-radius: var(--r-md);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  background: var(--brand-green);
  color: #fff;
  border: 1px solid transparent;
  transition: background 0.2s, border-color 0.2s, transform 0.2s, gap 0.2s;
}
.faq-action-btn:hover {
  background: color-mix(in srgb, var(--brand-green) 88%, white);
  gap: 8px;
}
.faq-action-btn--outline {
  background: transparent;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.28);
}
.faq-action-btn--outline:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.4);
}

@media (max-width: 900px) {
  .faq-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }
}

</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveal
  const revealObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });

  const revealEls = Array.from(document.querySelectorAll('.reveal'));
  const activateVisibleReveals = () => {
    const vh = window.innerHeight * 0.94;
    revealEls.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.top < vh && r.bottom > 0) {
        el.classList.add('in');
        revealObs.unobserve(el);
      }
    });
  };

  revealEls.forEach(el => revealObs.observe(el));
  requestAnimationFrame(() => requestAnimationFrame(activateVisibleReveals));

  // Animated counters
  const cObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const target = parseInt(el.dataset.target ?? '0', 10);
      if (prefersReduced) { el.textContent = String(target); cObs.unobserve(el); return; }
      const start = performance.now();
      const dur = 1100;
      const tick = (now: number) => {
        const p = Math.min((now - start) / dur, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      cObs.unobserve(el);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.counter').forEach(el => cObs.observe(el));

  // SSS: max-height ile aç/kapa, tek seferde bir soru açık
  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('.faq-item'));
  const getFaqPanel = (item: HTMLDetailsElement) =>
    item.querySelector<HTMLElement>('.faq-panel');

  const measureFaqPanel = (item: HTMLDetailsElement) => {
    const panel = getFaqPanel(item);
    const wrap = panel?.querySelector<HTMLElement>('.faq-a-wrap');
    return wrap ? wrap.offsetHeight : 0;
  };

  const openFaqItem = (item: HTMLDetailsElement) => {
    const panel = getFaqPanel(item);
    if (!panel) {
      item.open = true;
      return;
    }
    item.open = true;
    if (prefersReduced) {
      panel.style.maxHeight = '';
      return;
    }
    const height = measureFaqPanel(item);
    panel.style.maxHeight = '0px';
    panel.offsetHeight;
    panel.style.maxHeight = `${height}px`;
  };

  const closeFaqItem = (item: HTMLDetailsElement) =>
    new Promise<void>(resolve => {
      const panel = getFaqPanel(item);
      if (!item.open) {
        resolve();
        return;
      }
      if (!panel || prefersReduced) {
        item.open = false;
        panel && (panel.style.maxHeight = '');
        resolve();
        return;
      }
      const height = panel.scrollHeight;
      panel.style.maxHeight = `${height}px`;
      panel.offsetHeight;
      panel.style.maxHeight = '0px';

      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        window.clearTimeout(fallback);
        item.open = false;
        panel.style.maxHeight = '';
        resolve();
      };
      const onEnd = (e: TransitionEvent) => {
        if (e.target === panel && e.propertyName === 'max-height') finish();
      };
      panel.addEventListener('transitionend', onEnd, { once: true });
      const fallback = window.setTimeout(finish, 380);
    });

  faqItems.forEach(item => {
    const summary = item.querySelector('summary');
    summary?.addEventListener('click', async (e) => {
      e.preventDefault();
      if (!item.open) {
        await Promise.all(
          faqItems.filter(other => other !== item && other.open).map(closeFaqItem),
        );
        openFaqItem(item);
      } else {
        await closeFaqItem(item);
      }
    });
  });

  // Smooth scroll
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const href = (a as HTMLAnchorElement).getAttribute('href')!;
      if (href === '#') return;
      const el = document.querySelector(href);
      if (el) { e.preventDefault(); window.scrollTo({ top: (el as HTMLElement).offsetTop - 72, behavior: 'smooth' }); }
    });
  });
</script>
