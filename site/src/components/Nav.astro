---
export interface Props {
  darkHero?: boolean;
}
const { darkHero = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/program',   label: 'Programlar' },
  { href: '/basvur',    label: 'Başvuru'   },
  { href: '/mezunlar',  label: 'Mezunlar'   },
  { href: '/paydaslar', label: 'Partnerler' },
];
---

<nav class:list={['nav', { 'nav--dark-hero': darkHero }]} id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="FintechFellow Ana Sayfa">
      <img src="/assets/logos/logo-light.svg" alt="FintechFellow" width="auto" height="64" />
    </a>

    <ul class="nav-links" role="list">
      {links.map(l => (
        <li>
          <a href={l.href} class:list={[{ active: path === l.href }]}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/basvur" class="nav-cta">Başvuru <span class="nav-cta-arrow">→</span></a>

    <button class="nav-hamburger" aria-label="Menü" aria-expanded="false" id="navToggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile-menu" id="navMobile">
    <ul role="list">
      {links.map(l => (
        <li>
          <a href={l.href} class:list={[{ active: path === l.href }]}>
            {l.label}
          </a>
        </li>
      ))}
      <li><a href="/basvur" class="mobile-cta">Başvuru →</a></li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 50;
    padding: 20px 0;
    transition: background 0.3s, border-color 0.3s, padding 0.3s;
  }
  .nav.scrolled {
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }

  .nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-width: 0;
  }

  .nav-logo {
    justify-self: start;
  }

  .nav-links {
    justify-self: center;
  }

  .nav-cta,
  .nav-hamburger {
    justify-self: end;
  }

  /* Logo — tek dosya: logo-light.svg (şeffaf arka plan) */
  .nav-logo {
    display: flex;
    flex-shrink: 0;
    line-height: 0;
  }
  .nav-logo img {
    display: block;
    height: clamp(60px, 8vw, 72px);
    width: auto;
  }
  /* Mavi hero üzerinde okunabilirlik için beyaza çevir */
  .nav--dark-hero:not(.scrolled) .nav-logo img {
    filter: brightness(0) invert(1);
  }

  /* Links */
  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0; padding: 0;
    flex-shrink: 1;
    min-width: 0;
  }
  .nav-links a {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255,255,255,0.9);
    transition: color 0.2s;
  }
  .nav.scrolled .nav-links a { color: var(--ink-soft); }
  .nav-links a:hover { color: var(--green-500) !important; }
  .nav-links a.active { color: #fff; font-weight: 600; }
  .nav.scrolled .nav-links a.active { color: var(--ink); font-weight: 600; }

  /* CTA */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: var(--r-pill);
    background: var(--green-500);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    border: 0;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -10px rgba(66,186,109,0.55);
    background: var(--green-700);
  }
  .nav-cta-arrow { transition: transform 0.2s; }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(4px); }

  /* Hamburger */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: background 0.2s;
  }
  .nav.scrolled .nav-hamburger span { background: var(--ink); }

  /* Mobile menu */
  .nav-mobile-menu {
    display: none;
    position: absolute;
    top: 100%; left: 0; right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 16px 32px 24px;
  }
  .nav-mobile-menu.open { display: block; }
  .nav-mobile-menu ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .nav-mobile-menu li a {
    display: block;
    padding: 16px 0;
    font-size: 18px;
    color: var(--ink);
    border-bottom: 1px solid var(--line-soft);
    font-weight: 500;
  }
  .nav-mobile-menu li a:hover { color: var(--blue-500); }
  .mobile-cta {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 13px 24px;
    border-radius: var(--r-pill);
    background: var(--green-500);
    color: #fff !important;
    font-weight: 600;
    font-size: 17px;
    border-bottom: none !important;
  }

  @media (max-width: 1140px) {
    .nav-inner { gap: 18px; }
    .nav-links { gap: 28px; }
    .nav-cta { padding: 12px 22px; font-size: 15px; }
  }

  @media (max-width: 980px) {
    .nav-links { gap: 22px; }
    .nav-links a { font-size: 15px; }
    .nav-logo img { height: 56px; }
  }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const toggle = document.getElementById('navToggle')!;
  const mobile = document.getElementById('navMobile')!;

  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 40);
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggle.addEventListener('click', () => {
    const open = mobile.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
