---
const year = new Date().getFullYear();

const links = [
  { href: '/program', label: 'Programlar' },
  { href: '/basvur', label: 'Başvuru' },
  { href: '/mezunlar', label: 'Mezunlar' },
  { href: '/paydaslar', label: 'Partnerler' },
];
---

<footer class="footer">
  <div class="container foot-main">
    <a href="/" class="foot-logo" aria-label="FintechFellow Ana Sayfa">
      <img src="/assets/logos/logo-light.svg" alt="" width="auto" height="64" />
    </a>

    <nav class="foot-links" aria-label="Site">
      {links.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="foot-social">
      <a href="https://linkedin.com/company/fintechfellow" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="https://instagram.com/fintechfellow" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="container foot-meta">
    <p class="foot-copy">
      © {year} FintechFellow
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/iletisim">İletişim</a>
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/kvkk">KVKK</a>
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/marka-kilavuzu">Marka kiti</a>
    </p>
    <p class="foot-note">Ödeal, 42 İstanbul ve GİRVAK iş birliğiyle</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.5);
    padding: 40px 0 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .foot-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px 32px;
    padding-bottom: 28px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .foot-logo {
    justify-self: start;
  }

  .foot-links {
    justify-self: center;
  }

  .foot-social {
    justify-self: end;
  }

  .foot-logo {
    display: flex;
    flex-shrink: 0;
    opacity: 0.92;
    transition: opacity 0.2s;
  }
  .foot-logo img {
    display: block;
    height: clamp(60px, 8vw, 72px);
    width: auto;
  }
  .foot-logo:hover {
    opacity: 1;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px 18px;
  }
  .foot-links a {
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.58);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: var(--r-sm);
    transition: color 0.2s, background 0.2s;
  }
  .foot-links a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .foot-sep {
    color: rgba(255, 255, 255, 0.2);
    font-weight: 300;
    user-select: none;
  }

  .foot-social {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .foot-social a {
    display: flex;
    padding: 6px;
    color: rgba(255, 255, 255, 0.35);
    border-radius: var(--r-sm);
    transition: color 0.2s, background 0.2s;
  }
  .foot-social a:hover {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.05);
  }

  .foot-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 12px;
    line-height: 1.5;
  }

  .foot-copy {
    margin: 0;
    color: rgba(255, 255, 255, 0.38);
  }
  .foot-copy a {
    color: rgba(255, 255, 255, 0.38);
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot-copy a:hover {
    color: rgba(255, 255, 255, 0.72);
  }

  .foot-note {
    margin: 0;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.22);
    font-weight: 300;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 32px 0 28px;
    }
    .foot-main {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding-bottom: 24px;
      margin-bottom: 20px;
    }
    .foot-logo,
    .foot-links,
    .foot-social {
      justify-self: center;
    }
    .foot-links {
      justify-content: center;
      width: 100%;
    }
    .foot-meta {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
