---
import { programContentItems, type ProgramContentIcon } from '../data/program-content';

interface Props {
  title: string;
  intro?: string;
  rootId?: string;
}

const { title, intro, rootId = 'program-content' } = Astro.props;

const iconPaths: Record<ProgramContentIcon, string> = {
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  fintech:
    'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1',
  leaders:
    'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  fintalks:
    'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
  growth:
    'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
};
---

<div class="ff-pc" id={rootId} data-program-content>
  <div class="ff-pc-head reveal">
    <div class="sec-eyebrow">Program içeriği</div>
    <h2 class="sec-title" set:html={title} />
    {intro && <p class="sec-sub ff-pc-intro">{intro}</p>}
  </div>

  <div class="ff-pc-layout">
    <nav class="ff-pc-nav" aria-label="Program sekmeleri" role="tablist">
      {
        programContentItems.map((item, i) => (
          <button
            type="button"
            class:list={['ff-pc-tab', `ff-pc-tab--${item.tone}`, { active: i === 0 }]}
            role="tab"
            aria-selected={i === 0}
            aria-controls={`${rootId}-panel-${i}`}
            data-tab={i}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="ff-pc-tab-label">{item.tabLabel}</span>
          </button>
        ))
      }
    </nav>

    <div class="ff-pc-body">
      <div class="ff-pc-content-wrap">
        {
          programContentItems.map((item, i) => (
            <div
              id={`${rootId}-panel-${i}`}
              class:list={['ff-pc-panel', `ff-pc-panel--${item.tone}`, { active: i === 0 }]}
              role="tabpanel"
            >
              <div class="ff-pc-panel-inner">
                <h3>{item.heading}</h3>
                {item.body && <p>{item.body}</p>}
                {item.bodySecondary && <p>{item.bodySecondary}</p>}
                {item.bulletsLabel && <p class="ff-pc-lead">{item.bulletsLabel}</p>}
                {item.bullets && item.bullets.length > 0 && (
                <ul class="ff-pc-list">
                  {item.bullets.map((bullet) => (
                    <li>
                      {typeof bullet === 'string' ? (
                        bullet
                      ) : (
                        <>
                          {bullet.text}
                          {bullet.link && (
                            <>
                              {' — '}
                              <a
                                href={bullet.link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-link"
                              >
                                {bullet.link.label} <span aria-hidden="true">↗</span>
                              </a>
                            </>
                          )}
                        </>
                      )}
                    </li>
                  ))}
                </ul>
                )}
                {item.workshops?.map((workshop) => (
                  <div class="ff-pc-block">
                    <h4 class="ff-pc-lead">{workshop.title}</h4>
                    <p>{workshop.body}</p>
                  </div>
                ))}
                {item.callout && (
                  <div class="ff-pc-block">
                    <h4 class="ff-pc-lead">{item.callout.title}</h4>
                    <p>{item.callout.body}</p>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="ff-pc-visual-wrap" aria-hidden="true">
        <div class="ff-pc-visual-grid" aria-hidden="true" />
        {
          programContentItems.map((item, i) => (
            <div
              class:list={['ff-pc-visual', `ff-pc-visual--${item.visual.tone}`, { active: i === 0 }]}
              data-visual={i}
            >
              <div class="ff-pc-av-card">
                <span class="ff-pc-av-dot" aria-hidden="true" />
                <div class="ff-pc-av-icon">
                  <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={iconPaths[item.visual.icon]}
                    />
                  </svg>
                </div>
              </div>
              <span class="ff-pc-av-line" aria-hidden="true" />
              <div class="ff-pc-av-text">
                <p class="ff-pc-av-title">{item.visual.title}</p>
                {item.visual.sub && <p class="ff-pc-av-sub">{item.visual.sub}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  function initProgramContent(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ff-pc-tab'));
    const panels = root.querySelectorAll<HTMLElement>('.ff-pc-panel');
    const visuals = root.querySelectorAll<HTMLElement>('.ff-pc-visual');
    if (!tabs.length) return;

    const activate = (idx: number) => {
      tabs.forEach((t, i) => {
        t.classList.toggle('active', i === idx);
        t.setAttribute('aria-selected', i === idx ? 'true' : 'false');
        t.tabIndex = i === idx ? 0 : -1;
      });
      panels.forEach((p, i) => p.classList.toggle('active', i === idx));
      visuals.forEach((v, i) => v.classList.toggle('active', i === idx));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        activate(i);
        tab.focus();
      });
      tab.addEventListener('keydown', (e) => {
        const total = tabs.length;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          const next = (i + 1) % total;
          activate(next);
          tabs[next].focus();
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = (i - 1 + total) % total;
          activate(prev);
          tabs[prev].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(0);
          tabs[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(total - 1);
          tabs[total - 1].focus();
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-program-content]').forEach(initProgramContent);
</script>

<style>
  .ff-pc-head {
    margin-bottom: clamp(32px, 4vw, 44px);
    max-width: 720px;
  }

  .ff-pc-intro {
    margin-bottom: 0;
  }

  .ff-pc-layout {
    display: grid;
    grid-template-columns: minmax(220px, 24%) minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
    min-height: 480px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 12px 40px rgba(14, 17, 22, 0.04);
  }

  .ff-pc-body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 1fr);
    min-height: 100%;
    align-items: stretch;
  }

  .ff-pc-nav {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    border-right: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .ff-pc-tab {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 12px;
    padding: 16px 18px;
    min-height: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s;
  }

  .ff-pc-tab:last-child {
    border-bottom: 0;
  }

  .ff-pc-tab:hover:not(.active) {
    background: var(--line-soft);
  }

  .ff-pc-tab-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1.35;
    transition: color 0.2s;
  }

  .ff-pc-tab.active.ff-pc-tab--blue {
    background: var(--blue-50);
  }

  .ff-pc-tab.active.ff-pc-tab--blue .ff-pc-tab-label {
    color: var(--ink);
    font-weight: 700;
  }

  .ff-pc-tab.active.ff-pc-tab--green {
    background: var(--green-50);
  }

  .ff-pc-tab.active.ff-pc-tab--green .ff-pc-tab-label {
    color: var(--ink);
    font-weight: 700;
  }

  .ff-pc-content-wrap {
    padding: 40px 44px;
    display: grid;
    align-content: center;
    background: var(--bg);
    border-right: 1px solid var(--line);
    position: relative;
    min-height: 100%;
    overflow: auto;
  }

  .ff-pc-panel {
    display: none;
    grid-row: 1;
    grid-column: 1;
    animation: ffPcFadeUp 0.38s ease;
  }

  .ff-pc-panel.active {
    display: block;
  }

  @keyframes ffPcFadeUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ff-pc-panel h3 {
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 26px);
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    color: var(--ink);
  }

  .ff-pc-panel p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0 0 22px;
  }

  .ff-pc-lead {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .ff-pc-block + .ff-pc-block,
  .ff-pc-lead + .ff-pc-list,
  .ff-pc-block + .ff-pc-list {
    margin-top: 0;
  }

  .ff-pc-block {
    margin-top: 20px;
  }

  .ff-pc-panel-inner > h3 + .ff-pc-block,
  .ff-pc-panel-inner > p + .ff-pc-block,
  .ff-pc-panel-inner > .ff-pc-lead + .ff-pc-block {
    margin-top: 0;
  }

  .ff-pc-block + .ff-pc-block {
    margin-top: 20px;
  }

  .ff-pc-block .ff-pc-lead {
    margin-bottom: 8px;
  }

  .ff-pc-block p {
    margin-bottom: 0;
  }

  .ff-pc-panel ul,
  .ff-pc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ff-pc-panel ul li,
  .ff-pc-list li {
    position: relative;
    padding-left: 1.25em;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.45;
  }

  .ff-pc-panel ul li + li,
  .ff-pc-list li + li {
    margin-top: 5px;
  }

  .ff-pc-panel--blue ul li::before,
  .ff-pc-panel--green ul li::before,
  .ff-pc-panel--blue .ff-pc-list li::before,
  .ff-pc-panel--green .ff-pc-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    transform: translateY(-50%);
  }

  .ff-pc-panel--blue ul li::before {
    background: var(--brand-blue);
  }

  .ff-pc-panel--green ul li::before {
    background: var(--brand-green);
  }

  .ff-pc-visual-wrap {
    background: var(--brand-blue);
    position: relative;
    display: block;
    min-height: 100%;
    overflow: hidden;
  }

  .ff-pc-visual-wrap > .ff-pc-visual {
    position: absolute;
    inset: 0;
    min-height: 100%;
  }

  .ff-pc-visual-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.14;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.45) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.45) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 85% 75% at 50% 50%, black 30%, transparent 100%);
    pointer-events: none;
  }

  .ff-pc-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 28px;
    text-align: center;
    gap: 0;
    z-index: 1;
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.28s ease, visibility 0.28s ease;
  }

  .ff-pc-visual::before,
  .ff-pc-visual::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .ff-pc-visual[data-visual='0']::before {
    width: 240px;
    height: 240px;
    top: -72px;
    right: 4%;
    background: color-mix(in srgb, var(--brand-green) 24%, transparent);
  }

  .ff-pc-visual[data-visual='0']::after {
    width: 320px;
    height: 320px;
    left: -100px;
    bottom: -110px;
    background: rgba(255, 255, 255, 0.05);
  }

  .ff-pc-visual[data-visual='1']::before {
    width: 180px;
    height: 180px;
    left: 6%;
    bottom: -64px;
    background: color-mix(in srgb, var(--brand-green) 30%, transparent);
  }

  .ff-pc-visual[data-visual='1']::after {
    width: 140px;
    height: 140px;
    right: -36px;
    top: 18%;
    background: color-mix(in srgb, var(--brand-blue-light) 28%, transparent);
  }

  .ff-pc-visual[data-visual='2']::before {
    width: 300px;
    height: 300px;
    right: -110px;
    bottom: -48px;
    background: rgba(255, 255, 255, 0.045);
  }

  .ff-pc-visual[data-visual='2']::after {
    width: 200px;
    height: 200px;
    left: 10%;
    top: -56px;
    background: color-mix(in srgb, var(--brand-green) 20%, transparent);
  }

  .ff-pc-visual[data-visual='3']::before {
    width: 168px;
    height: 168px;
    right: 12%;
    bottom: 8%;
    background: color-mix(in srgb, var(--brand-green) 26%, transparent);
  }

  .ff-pc-visual[data-visual='3']::after {
    width: 120px;
    height: 120px;
    left: -48px;
    top: 14%;
    background: color-mix(in srgb, var(--brand-blue-light) 32%, transparent);
  }

  .ff-pc-visual[data-visual='4']::before {
    width: 340px;
    height: 340px;
    left: -88px;
    bottom: -96px;
    background: rgba(255, 255, 255, 0.04);
  }

  .ff-pc-visual[data-visual='4']::after {
    width: 260px;
    height: 260px;
    right: -28px;
    top: 6%;
    background: color-mix(in srgb, var(--brand-green) 22%, transparent);
  }

  .ff-pc-visual.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .ff-pc-av-card,
  .ff-pc-av-line,
  .ff-pc-av-text {
    position: relative;
    z-index: 1;
  }

  .ff-pc-av-card {
    width: 96px;
    height: 96px;
    border-radius: var(--r-md);
    background: #fff;
    border: 1px solid var(--brand-line);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 22px;
    box-shadow: 0 16px 40px rgba(14, 17, 22, 0.14);
  }

  .ff-pc-av-dot {
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--brand-green);
    box-shadow: 0 0 0 3px var(--brand-blue);
  }

  .ff-pc-av-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    color: var(--brand-blue);
  }

  .ff-pc-visual--green .ff-pc-av-icon {
    color: var(--brand-green);
  }

  .ff-pc-visual[data-visual='0'] .ff-pc-av-icon {
    color: var(--brand-green);
  }

  .ff-pc-av-line {
    display: block;
    width: 48px;
    height: 3px;
    background: var(--brand-green);
    margin: 0 auto 14px;
    border-radius: 1px;
  }

  .ff-pc-av-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 52px;
    width: 100%;
    max-width: 20ch;
  }

  .ff-pc-av-title {
    margin: 0 0 6px;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: #fff;
    min-height: 1.25em;
    width: 100%;
  }

  .ff-pc-av-sub {
    margin: 0;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.4;
    min-height: 1.4em;
    width: 100%;
  }

  @media (max-width: 1024px) {
    .ff-pc-layout {
      grid-template-columns: minmax(200px, 26%) minmax(0, 1fr);
      min-height: 440px;
    }

    .ff-pc-body {
      grid-template-columns: minmax(0, 1.15fr) minmax(240px, 1fr);
    }

    .ff-pc-content-wrap {
      padding: 32px 28px;
    }
  }

  @media (max-width: 860px) {
    .ff-pc-layout {
      grid-template-columns: 1fr;
      min-height: 0;
      border-radius: var(--r-md);
    }

    .ff-pc-nav {
      flex-direction: row;
      flex-wrap: nowrap;
      min-height: 0;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ff-pc-nav::-webkit-scrollbar {
      display: none;
    }

    .ff-pc-tab {
      flex: 0 0 auto;
      min-width: max-content;
      padding: 14px 16px;
      white-space: nowrap;
    }

    .ff-pc-tab-label {
      font-size: 12px;
    }

    .ff-pc-body {
      grid-template-columns: 1fr;
    }

    .ff-pc-content-wrap {
      border-right: 0;
      padding: 28px 22px 24px;
    }

    .ff-pc-visual-wrap {
      min-height: 220px;
      border-top: 1px solid var(--line);
    }

    .ff-pc-visual {
      padding: 28px 24px;
    }
  }

  @media (max-width: 560px) {
    .ff-pc-tab-label {
      font-size: 11px;
    }

    .ff-pc-panel h3 {
      font-size: 20px;
    }
  }
</style>
